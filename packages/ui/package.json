{
  "name": "@creative-ui/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Distributable component, hook and lib sources. Mirrors the consumer install layout (components/ui, hooks, lib) so the registry serves exactly these files.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "motion": "^14.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
