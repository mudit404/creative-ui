{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "//#build:registry": {
      "cache": false,
      "env": ["REGISTRY_URL", "NEXT_PUBLIC_SITE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "//#build:registry"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SITE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#build:registry"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
